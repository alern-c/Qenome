{
  "description": "A plain equality lookup on an unindexed column turns the full scan into an index search.",
  "args": [
    "--bind",
    "1:int:1235"
  ],
  "expect": {
    "exit": 0,
    "exit_code": 0,
    "result": "match",
    "verdict": "improved",
    "plan_changed": true,
    "baseline_plan": {
      "contains": [
        "SCAN events"
      ],
      "excludes": [
        "SEARCH events"
      ]
    },
    "variant_plan": {
      "contains": [
        "SEARCH events USING INDEX idx_customer (customer_id=?)"
      ],
      "excludes": [
        "SCAN events"
      ]
    },
    "rows_read": {
      "direction": "decrease",
      "max_ratio": 0.01
    },
    "rows_written": "same",
    "warnings": {
      "excludes": [
        "no_analyze_stats",
        "data_too_small"
      ]
    }
  }
}
