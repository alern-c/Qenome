{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qenome-report.schema.json",
  "title": "Qenome comparison report (schema_version 2)",
  "description": "Stdout object after a comparison. Timing evidence and warnings are emitted. SQLite detail fields remain reserved. See docs/json.md.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "exit_code",
    "statement",
    "verdict",
    "verdict_reasons",
    "result",
    "row_order",
    "result_reasons",
    "row_differences",
    "plan_changed",
    "baseline",
    "variant",
    "timing",
    "size_bytes",
    "inputs",
    "environment",
    "measurement",
    "binds",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "exit_code": {
      "description": "A variant-only --migration comparison writes 0 and does not change the batch exit code.",
      "enum": [0, 3, 4]
    },
    "statement": {
      "description": "select for a SELECT comparison, write for an INSERT, UPDATE, DELETE, or REPLACE comparison.",
      "enum": ["select", "write"]
    },
    "verdict": {
      "description": "regressed appears only in a --migration batch: the rows match but the migration made the query read or write more rows. not-judged also covers a variant-only --migration query whose baseline cannot prepare it, and a --write comparison that was not run.",
      "enum": ["improved", "no-effect", "needs-check", "regressed", "not-judged"]
    },
    "verdict_reasons": { "type": "array", "items": { "type": "string" } },
    "result": {
      "description": "A variant-only --migration query is incomparable: there is no baseline result to compare.",
      "enum": ["match", "mismatch", "incomparable"]
    },
    "row_order": { "enum": ["same", "differs", "not-applicable"] },
    "result_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["text", "hint"],
        "properties": {
          "text": { "type": "string" },
          "hint": { "type": ["string", "null"] }
        }
      }
    },
    "row_differences": {
      "type": "object",
      "additionalProperties": true,
      "required": ["baseline_only", "variant_only", "baseline_only_examples", "variant_only_examples"],
      "properties": {
        "baseline_only": { "type": "integer" },
        "variant_only": { "type": "integer" },
        "baseline_only_examples": { "type": "array" },
        "variant_only_examples": { "type": "array" }
      }
    },
    "plan_changed": {
      "description": "The query plan text differs. True for a variant-only --migration query, which has no baseline plan.",
      "type": "boolean"
    },
    "baseline": {
      "description": "Null only for a variant-only --migration query: the migration added the column or table, so the baseline cannot prepare the SELECT.",
      "anyOf": [
        { "$ref": "#/$defs/side" },
        { "type": "null" }
      ]
    },
    "variant": { "$ref": "#/$defs/side" },
    "timing": {
      "description": "Null when not timed. Timing evidence is reference only and does not change the row verdict.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "rounds",
            "variant_faster_rounds",
            "ratio",
            "baseline",
            "variant",
            "noise_band",
            "confidence_interval",
            "median_difference_ns",
            "effect",
            "unavailable_reason"
          ],
          "properties": {
            "rounds": {
              "type": "integer"
            },
            "variant_faster_rounds": {
              "type": "integer"
            },
            "ratio": {
              "type": [
                "number",
                "null"
              ]
            },
            "baseline": {
              "$ref": "#/$defs/timeStats"
            },
            "variant": {
              "$ref": "#/$defs/timeStats"
            },
            "noise_band": {
              "type": "object",
              "required": [
                "method",
                "pairs",
                "threshold_ns"
              ],
              "properties": {
                "method": {
                  "const": "baseline-aa-absolute-difference-p95"
                },
                "pairs": {
                  "type": "integer",
                  "minimum": 1
                },
                "threshold_ns": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "confidence_interval": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "method",
                    "level",
                    "coverage",
                    "lower_ns",
                    "upper_ns"
                  ],
                  "properties": {
                    "method": {
                      "const": "paired-sign-median"
                    },
                    "level": {
                      "const": 0.95
                    },
                    "coverage": {
                      "type": "number",
                      "minimum": 0.95,
                      "maximum": 1
                    },
                    "lower_ns": {
                      "type": "number"
                    },
                    "upper_ns": {
                      "type": "number"
                    }
                  }
                }
              ]
            },
            "median_difference_ns": {
              "type": "number"
            },
            "effect": {
              "enum": [
                "faster",
                "slower",
                "no-difference",
                "insufficient-samples"
              ]
            },
            "unavailable_reason": {
              "enum": [
                null,
                "too-few-rounds",
                "zero-duration",
                "no-observed-variation"
              ]
            }
          }
        }
      ]
    },
    "size_bytes": {
      "type": "object",
      "additionalProperties": true,
      "required": ["baseline", "variant", "increase"],
      "properties": {
        "baseline": { "type": "integer" },
        "variant": { "type": "integer" },
        "increase": { "type": "integer" }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "required": ["database", "index_sql"],
      "anyOf": [
        { "required": ["select"] },
        { "required": ["write"] }
      ],
      "properties": {
        "database": { "type": "string" },
        "select": { "type": "string" },
        "write": { "type": "string" },
        "index_sql": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["qenome_version", "sqlite_version", "sqlite_source_id", "zig_version", "build_mode", "os", "arch", "work_dir_parent"]
    },
    "d1": { "type": "object", "additionalProperties": true },
    "seed_data": {
      "description": "Present only with --seed-data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "seed", "rows", "tables"],
      "properties": {
        "path": { "type": "string" },
        "seed": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["table", "rows"],
            "properties": {
              "table": { "type": "string" },
              "rows": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "measurement": { "type": "object", "additionalProperties": true },
    "binds": { "type": "array" },
    "warnings": {
      "description": "Always emitted; advisory checks on the candidate index table in the baseline snapshot and on the variant plan.",
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    },
    "sqlite": {
      "description": "Reserved. Not emitted yet. Read environment.sqlite_version until bundled_version exists.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "bundled_version": { "type": "string" },
        "db_header_version": { "type": "string" }
      }
    }
  },
  "$defs": {
    "side": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rows", "plan", "counters"],
      "properties": {
        "rows": { "type": "integer" },
        "plan": { "type": "array" },
        "counters": { "$ref": "#/$defs/counters" },
        "changes": {
          "description": "Present only for --write: sqlite3_changes for the statement (trigger and foreign-key changes excluded).",
          "type": "integer"
        },
        "total_changes": {
          "description": "Present only for --write: the difference of sqlite3_total_changes (trigger and foreign-key changes included).",
          "type": "integer"
        },
        "executions": {
          "description": "Present only for --write: the rolled-back executions per copy.",
          "type": "integer"
        },
        "rows_read": {
          "description": "Not emitted at this level. The implemented field is counters.rows_read.",
          "type": "integer"
        },
        "rows_written": {
          "description": "Not emitted at this level. The implemented field is counters.rows_written.",
          "type": "integer"
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rows_read", "rows_written", "fullscan_steps", "vm_steps", "sort_ops", "autoindex_rows"],
      "properties": {
        "rows_read": { "type": "integer" },
        "rows_written": { "type": "integer" },
        "fullscan_steps": { "type": "integer" },
        "vm_steps": { "type": "integer" },
        "sort_ops": { "type": "integer" },
        "autoindex_rows": { "type": "integer" }
      }
    },
    "timeStats": {
      "type": "object",
      "additionalProperties": true,
      "required": ["median_ns", "p25_ns", "p75_ns", "min_ns", "max_ns"],
      "properties": {
        "median_ns": { "type": "integer" },
        "p25_ns": { "type": "integer" },
        "p75_ns": { "type": "integer" },
        "min_ns": { "type": "integer" },
        "max_ns": { "type": "integer" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "description": "no_analyze_stats, data_too_small, or bind_dependent_partial_index.",
          "type": "string"
        },
        "message": { "type": "string" }
      }
    }
  }
}
