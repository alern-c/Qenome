{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qenome-batch.schema.json",
  "title": "Qenome batch report (batch_schema_version 1)",
  "description": "Stdout object after --batch. Each compared pair embeds the schema_version 2 comparison object from qenome-report.schema.json. See docs/json.md.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "batch_schema_version",
    "exit_code",
    "recommended",
    "summary",
    "results",
    "warnings"
  ],
  "properties": {
    "batch_schema_version": { "const": 1 },
    "exit_code": { "enum": [0, 1, 3, 4, 124] },
    "recommended": {
      "description": "A manifest index_sql path, or suggested:N with --suggest. Null when no candidate qualifies.",
      "type": ["string", "null"]
    },
    "summary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/summary" }
    },
    "results": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/result" }
    },
    "warnings": {
      "description": "What --suggest dropped or could not do. Empty without --suggest.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "enum": [
              "suggest_query_skipped",
              "suggestion_rejected",
              "suggestions_truncated",
              "no_suggestions",
              "suggest_failed"
            ]
          },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "candidate",
        "source",
        "index_sql_text",
        "status",
        "failure",
        "improved",
        "no_effect",
        "needs_check",
        "mismatch",
        "incomparable",
        "timeout",
        "size_increase"
      ],
      "properties": {
        "candidate": {
          "description": "The manifest index_sql string, or suggested:N when --suggest proposed the index.",
          "type": "string"
        },
        "source": { "enum": ["manifest", "suggested"] },
        "index_sql_text": {
          "description": "The SQL text. For a manifest candidate, the contents of its file.",
          "type": "string"
        },
        "status": { "enum": ["compared", "index_rejected", "index_timeout"] },
        "failure": {
          "description": "Null when the candidate was compared. Otherwise the reason the index was not built.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "enum": ["index_rejected", "index_timeout"] },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "improved": { "type": ["integer", "null"], "minimum": 0 },
        "no_effect": { "type": ["integer", "null"], "minimum": 0 },
        "needs_check": { "type": ["integer", "null"], "minimum": 0 },
        "mismatch": { "type": ["integer", "null"], "minimum": 0 },
        "incomparable": { "type": ["integer", "null"], "minimum": 0 },
        "timeout": { "type": ["integer", "null"], "minimum": 0 },
        "size_increase": {
          "description": "Variant file size minus baseline file size, in bytes. Signed. Null when no index was built.",
          "type": ["integer", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "compared" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "failure": { "type": "null" },
              "improved": { "type": "integer" },
              "no_effect": { "type": "integer" },
              "needs_check": { "type": "integer" },
              "mismatch": { "type": "integer" },
              "incomparable": { "type": "integer" },
              "timeout": { "type": "integer" },
              "size_increase": { "type": "integer" }
            }
          },
          "else": {
            "properties": {
              "failure": { "type": "object" },
              "improved": { "type": "null" },
              "no_effect": { "type": "null" },
              "needs_check": { "type": "null" },
              "mismatch": { "type": "null" },
              "incomparable": { "type": "null" },
              "timeout": { "type": "null" },
              "size_increase": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "index_rejected" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "failure": {
                "properties": { "code": { "const": "index_rejected" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "index_timeout" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "failure": {
                "properties": { "code": { "const": "index_timeout" } }
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["query", "candidate", "status", "comparison"],
      "properties": {
        "query": { "type": "string" },
        "candidate": { "type": "string" },
        "status": { "enum": ["compared", "variant_timeout"] },
        "comparison": {
          "description": "The schema_version 2 comparison object, or null when the variant SELECT reached the time limit.",
          "anyOf": [
            { "type": "null" },
            { "$ref": "qenome-report.schema.json" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "compared" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "comparison": { "$ref": "qenome-report.schema.json" }
            }
          },
          "else": {
            "properties": {
              "comparison": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
